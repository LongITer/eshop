{
  "name": "auth-service",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node src/main.ts"
  },
  "nx": {
    "name": "auth-service",
    "projectType": "application",
    "sourceRoot": "auth-service/src",
    "targets": {
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "auth-service:build",
          "runBuildTargetDependencies": true,
          "inspect": false
        },
        "configurations": {
          "development": {
            "buildTarget": "auth-service:build"
          },
          "production": {
            "buildTarget": "auth-service:build"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "build": {
        "executor": "@nx/webpack:webpack",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "target": "node",
          "compiler": "tsc",
          "outputPath": "apps/auth-service/dist",
          "main": "apps/auth-service/src/main.ts",
          "tsConfig": "apps/auth-service/tsconfig.app.json",
          "webpackConfig": "apps/auth-service/webpack.config.js"
        }
      }
    }
  }
}
