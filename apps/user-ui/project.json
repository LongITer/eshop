{
  "name": "user-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/user-ui/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "@nx/next:server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "user-ui:build",
        "dev": true,
        "port": 3000
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{projectRoot}/.next", "{projectRoot}/dist"],
      "options": {
        "outputPath": "dist/apps/user-ui",
        "tsConfig": "apps/user-ui/tsconfig.json",
        "postcssConfig": "apps/user-ui/postcss.config.js"
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "inspect": true
        },
        "production": {}
      }
    },
    "start": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "user-ui:build",
        "port": 3000
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/user-ui/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "jestConfig": "apps/user-ui/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": []
}