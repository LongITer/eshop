{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "dynamicRoutes": [
    {
      "page": "/dashboard/edit-product/[id]",
      "regex": "^/dashboard/edit\\-product/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/edit\\-product/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/orders/[id]",
      "regex": "^/dashboard/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/dashboard/orders/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/dashboard",
      "regex": "^/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard(?:/)?$"
    },
    {
      "page": "/dashboard/all-products",
      "regex": "^/dashboard/all\\-products(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/all\\-products(?:/)?$"
    },
    {
      "page": "/dashboard/create-product",
      "regex": "^/dashboard/create\\-product(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/create\\-product(?:/)?$"
    },
    {
      "page": "/dashboard/discount-codes",
      "regex": "^/dashboard/discount\\-codes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/discount\\-codes(?:/)?$"
    },
    {
      "page": "/dashboard/inbox",
      "regex": "^/dashboard/inbox(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/inbox(?:/)?$"
    },
    {
      "page": "/dashboard/inventory",
      "regex": "^/dashboard/inventory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/inventory(?:/)?$"
    },
    {
      "page": "/dashboard/notification",
      "regex": "^/dashboard/notification(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/notification(?:/)?$"
    },
    {
      "page": "/dashboard/orders",
      "regex": "^/dashboard/orders(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/orders(?:/)?$"
    },
    {
      "page": "/dashboard/payment",
      "regex": "^/dashboard/payment(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/payment(?:/)?$"
    },
    {
      "page": "/dashboard/reports",
      "regex": "^/dashboard/reports(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/reports(?:/)?$"
    },
    {
      "page": "/dashboard/shop-settings",
      "regex": "^/dashboard/shop\\-settings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/dashboard/shop\\-settings(?:/)?$"
    },
    {
      "page": "/login",
      "regex": "^/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/login(?:/)?$"
    },
    {
      "page": "/signup",
      "regex": "^/signup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signup(?:/)?$"
    },
    {
      "page": "/success",
      "regex": "^/success(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/success(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "RSC",
    "varyHeader": "RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch",
    "prefetchHeader": "Next-Router-Prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "Next-Router-Segment-Prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://localhost:8080/api/:path*",
      "regex": "^/api(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/product/:path*",
      "destination": "http://localhost:8080/product/:path*",
      "regex": "^/product(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/order/:path*",
      "destination": "http://localhost:8080/order/:path*",
      "regex": "^/order(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/chatting/:path*",
      "destination": "http://localhost:8080/chatting/:path*",
      "regex": "^/chatting(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    },
    {
      "source": "/chatting-ws",
      "destination": "http://localhost:6006",
      "regex": "^/chatting-ws(?:/)?$"
    }
  ]
}